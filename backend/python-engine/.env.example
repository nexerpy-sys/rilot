# Instagram Credentials (Required for Session Bootstrap & Live Upload)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Google Apps Script Web App Engine Endpoint & Engine Secret Key (Set in GitHub Actions Secrets)
RILOT_ENGINE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
RILOT_ENGINE_API_KEY=your_rilot_engine_api_key

# Timezone & Scheduling Defaults (Asia/Kolkata IST)
HASHTAGS=fitness,calisthenics,streetworkout,gymmotivation,mobilitytraining
POST_INTERVAL_HOURS=6
MAX_POSTS_PER_CYCLE=2
DELAY_BETWEEN_POSTS=60
DAILY_POSTING_LIMIT=6

# Safety Flags (Dry-Run ON and Auto-Publish OFF by default until testing is verified)
DRY_RUN_MODE=true
AUTO_PUBLISH_ENABLED=false
